{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "scePath",
      "type": "promptString",
      "description": "Path to your .sce file (relative to workspace root is OK)",
      "default": "path\\to\\your_measurement.sce"
    },
    {
      "id": "freqHz",
      "type": "promptString",
      "description": "Target frequency in Hz (nearest match by default)",
      "default": "100"
    }
  ],
  "tasks": [
    {
      "label": "Setup: venv (.vrenv) + requirements",
      "type": "shell",
      "command": "powershell",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& { if (!(Test-Path .vrenv)) { py -m venv .vrenv }; & .\\.vrenv\\Scripts\\python.exe -m pip install --upgrade pip; & .\\.vrenv\\Scripts\\python.exe -m pip install -r requirements.txt }"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run: animation (prompted)",
      "type": "shell",
      "command": ".\\.vrenv\\Scripts\\python.exe",
      "args": ["main.py", "--sce", "${input:scePath}", "--freq", "${input:freqHz}"],
      "problemMatcher": []
    },
    {
      "label": "Run: mean amplitude (prompted)",
      "type": "shell",
      "command": ".\\.vrenv\\Scripts\\python.exe",
      "args": ["main.py", "--sce", "${input:scePath}", "--mean-only"],
      "problemMatcher": []
    }
  ]
}
